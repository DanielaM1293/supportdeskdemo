# Copy to .env and fill in. Never commit real secrets.
# APP_ENV=production makes the app refuse to start without a PostgreSQL DATABASE_URL.
APP_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Leave empty locally to use sqlite in the instance folder.
# Production example: postgresql://user:password@host:5432/supportdesk
DATABASE_URL=
